{
  "manifest_version": 3,
  "name": "FoolFuuka X",
  "version": "0.6.52",
  "description": "FoolFuuka X with archive previews, persistent image caching, and Desuarchive Catbox link previews and optional embedding, plus developer tripcode capcode.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://desuarchive.org/*",
    "https://*.desuarchive.org/*",
    "https://arch.b4k.dev/*",
    "https://boards.4chan.org/*",
    "https://boards.4channel.org/*",
    "https://archived.moe/*",
    "https://*.archived.moe/*"
  ],
  "action": {
    "default_title": "FoolFuuka X",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/FoolFuukaX-16.png",
      "32": "icons/FoolFuukaX-32.png",
      "48": "icons/FoolFuukaX-48.png",
      "64": "icons/FoolFuukaX-64.png",
      "128": "icons/FoolFuukaX-128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://desuarchive.org/*",
        "https://*.desuarchive.org/*",
        "https://arch.b4k.dev/*",
        "https://boards.4chan.org/*",
        "https://boards.4channel.org/*",
        "https://archived.moe/*",
        "https://*.archived.moe/*",
        "https://4chan.org/*",
        "https://*.4chan.org/*",
        "https://4channel.org/*",
        "https://*.4channel.org/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/FoolFuukaX-16.png",
    "32": "icons/FoolFuukaX-32.png",
    "48": "icons/FoolFuukaX-48.png",
    "64": "icons/FoolFuukaX-64.png",
    "128": "icons/FoolFuukaX-128.png"
  }
}
